    },
    {
      "facade": "AKORT.Beta12RollbackFacade",
      "boundary": "after confirmation revalidation and before rollback enqueue"
    }
  ],
  "startReservation": {
    "storage": "ScriptProperties",
    "property": "AKORT_BETA14_START_RESERVATION_V1",
    "ttlMs": 180000,
    "purpose": "close the pre-check/enqueue race without adding a queue or executor",
    "automaticRelease": true,
    "expiredReservationAdoption": "delete before the next guarded start",
    "invalidReservationBehavior": "FAIL_CLOSED"
  },
  "normalizedNextActions": [
